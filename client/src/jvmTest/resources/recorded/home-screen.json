            "type": "navigate",
            "deeplink": "app://plans"
          }
        },
        {
          "label": "Orders",
          "action": {
            "type": "navigate",
            "deeplink": "app://orders"
          }
        },
        {
          "label": "Profile",
          "action": {
            "type": "navigate",
            "deeplink": "app://profile"
          }
