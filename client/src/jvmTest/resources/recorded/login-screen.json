{
  "schema": {
    "formId": "login",
    "fields": [
      {
        "type": "text_field",
        "fieldId": "msisdn",
        "rules": [
          {
            "type": "required",
            "errorMessage": "Enter your number"
          }
        ]
      }
    ]
  },
  "screen": {
    "type": "column",
    "id": "login",
    "children": [
      {
        "type": "text",
        "id": "login-title",
        "text": "Sign in",
        "style": "headline_small",
        "color": "on_surface"
      },
      {
